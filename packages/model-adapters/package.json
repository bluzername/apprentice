    "bench:local-model": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@apprentice/schemas": "workspace:*",
    "@apprentice/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
