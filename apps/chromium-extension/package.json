{
  "name": "@apprentice/chromium-extension",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build --configLoader runner && tsx scripts/package-zip.ts",
    "zip": "tsx scripts/package-zip.ts"
  },
  "dependencies": {
    "@apprentice/schemas": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.20",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yazl": "^3.3.1",
    "@types/yazl": "^2.4.6",
    "tsx": "^4.20.0"
  }
}
